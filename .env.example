# Copy this file to .env and fill in your own values.
# This example file is safe to share. The real .env file must stay private.

# Which file starts the application.
FLASK_APP=run.py

# 1 shows detailed errors while developing. Must be 0 on a live server.
FLASK_DEBUG=1

# Signs login sessions and form security tokens. Use a long random value.
# Create one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Where the database is stored. This default creates a local SQLite file.
DATABASE_URL=sqlite:///citizen_compass.db
